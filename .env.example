# This file is read by the server-side/runtime process only. Never commit a real key.
# The names intentionally match the external-API convention used by the referenced project.

DEFAULT_MODEL_MODE=api

# OpenAI-compatible / Responses model
OPENAI_API_KEY=replace-with-a-server-side-key
OPENAI_BASE_URL=replace-with-a-server-side-url
OPENAI_MODEL=gpt-5.5
MODEL_API_MODE=responses
MODEL_API_PATH=/responses

# 模型按职责分流：局内 Task Agent 默认关闭 reasoning/thinking；Meta Agent 保留 gpt-5.5 原配置。
# 两者复用上方的 API 地址和服务端密钥；不要在此填写真实密钥。
WEREWOLF_TASK_MODEL=deepseek-v4-flash
WEREWOLF_TASK_REASONING_EFFORT=none
WEREWOLF_META_MODEL=gpt-5.5
# 留空即不向 Meta Agent 的 Responses 请求传 reasoning.effort，保留上游默认行为。
WEREWOLF_META_REASONING_EFFORT=

# Optional self-hosted OpenAI-compatible model
SELF_HOSTED_MODEL_NAME=
SELF_HOSTED_MODEL_BASE_URL=
SELF_HOSTED_MODEL_API_MODE=chat_completions
SELF_HOSTED_MODEL_API_PATH=/v1/chat/completions
SELF_HOSTED_MODEL_API_KEY=
SELF_HOSTED_MODEL_REQUIRES_API_KEY=false
SELF_HOSTED_MODEL_ENABLE_THINKING=false

# Transport reliability and output budget
MODEL_MAX_RETRIES=2
MODEL_RETRY_DELAY_MS=300
MODEL_TIMEOUT_MS=45000
MAX_OUTPUT_TOKENS=900

# Some Responses-compatible gateways reject an explicit value. Leave empty to omit it.
RESPONSES_MAX_OUTPUT_TOKENS=

# Season 2 Task-Agent Harness（可选）
WEREWOLF_SEASON2_RECORD_DIRECTORY=records/seasons/season2
WEREWOLF_SEASON2_BASELINE_SKILL_DIRECTORY=archives/season1-rule-overhaul-20260804/skills/round0/input
WEREWOLF_SEASON2_REPLAY_BATCH_SIZE=2
WEREWOLF_SEASON2_CANDIDATE_COUNT=3
WEREWOLF_SEASON2_PROMOTE=false
# 留空时完全关闭外部检索；若启用，provider 只能在赛后 Meta-Agent 阶段使用。
WEREWOLF_SEASON2_RESEARCH_ENDPOINT=
WEREWOLF_SEASON2_RESEARCH_API_KEY=
WEREWOLF_SEASON2_RESEARCH_PROVIDER=openai
