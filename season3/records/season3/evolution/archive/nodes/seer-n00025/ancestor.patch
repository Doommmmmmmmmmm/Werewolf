+    @staticmethod
+    def _target_ids_for_kind(request: Mapping[str, Any], kind: str) -> list[str]:
+        raw_actions = request.get("allowed_actions")
+        allowed_actions = raw_actions if isinstance(raw_actions, list) else []
+        for allowed in allowed_actions:
+            if not isinstance(allowed, Mapping) or allowed.get("kind") != kind:
+                continue
+            target_ids = allowed.get("target_ids")
+            if isinstance(target_ids, list):
+                return [str(target_id) for target_id in target_ids]
+        return []
+
+    @staticmethod
+    def _repair_seer_vote(
+        action: dict[str, Any], turn_packet: Mapping[str, Any], known_results: list[dict[str, str]]
+    ) -> dict[str, Any]:
+        request = turn_packet.get("request")
+        if not isinstance(request, Mapping):
+            return action
+        legal_targets = TaskAgent._target_ids_for_kind(request, "day_vote")
+        if not legal_targets:
+            return action
+        known_map = {item["target_id"]: item["team"] for item in known_results}
+        main_target = TaskAgent._extract_public_main_vote_target(turn_packet, legal_targets)
+        if main_target and known_map.get(main_target) != "village":
+            if action.get("target_id") != main_target:
+                repaired = dict(action)
+                repaired["target_id"] = main_target
+                return repaired
+        selected = str(action.get("target_id") or "")
+        if known_map.get(selected) == "village":
+            wolves = [target_id for target_id in legal_targets if known_map.get(target_id) == "wolf"]
+            alternatives = wolves or [target_id for target_id in legal_targets if known_map.get(target_id) != "village"]
+            if alternatives:
+                repaired = dict(action)
+                repaired["target_id"] = alternatives[0]
+                return repaired
+        return action
