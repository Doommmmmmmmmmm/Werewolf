+            return action
+        known_map = {item["target_id"]: item["team"] for item in known_results}
+        dead_targets = TaskAgent._dead_player_ids(turn_packet.get("public_state"))
+        self_id = str(request.get("player_id") or turn_packet.get("self", {}).get("player_id") or "")
+        candidates = [target_id for target_id in transfer_targets if target_id != self_id and target_id not in dead_targets]
+        if not candidates:
+            return action
+        golds = [target_id for target_id in candidates if known_map.get(target_id) == "village"]
+        non_wolves = [target_id for target_id in candidates if known_map.get(target_id) != "wolf"]
+        chosen = (golds or TaskAgent._trusted_badge_targets(turn_packet, non_wolves) or non_wolves or candidates)[0]
+        if action.get("kind") != "sheriff_badge_transfer" or action.get("target_id") != chosen:
+            return {
+                "request_id": str(request.get("request_id")),
+                "player_id": str(request.get("player_id")),
+                "kind": "sheriff_badge_transfer",
+                "target_id": chosen,
+            }
+        return action
+
+    @staticmethod
+    def _dialogue_entries(turn_packet: Mapping[str, Any]) -> list[Mapping[str, Any]]:
+        tool_context = turn_packet.get("tool_context")
+        if not isinstance(tool_context, Mapping):
+            return []
+        dialogue = tool_context.get("current_round_dialogue")
+        if not isinstance(dialogue, list):
+            return []
+        return [item for item in dialogue if isinstance(item, Mapping)]
+
+    @staticmethod
+    def _entry_player_id(entry: Mapping[str, Any]) -> str:
+        for key in ("player_id", "speaker_id", "speaker", "actor_id", "from"):
+            value = entry.get(key)
+            if value is not None:
+                return str(value)
+        return ""
+
+    @staticmethod
+    def _entry_text(entry: Mapping[str, Any]) -> str:
+        for key in ("text", "content", "message", "speech"):
+            value = entry.get(key)
+            if isinstance(value, str):
+                return value
+        return ""
+
+    @staticmethod
+    def _extract_public_main_vote_target(turn_packet: Mapping[str, Any], legal_targets: list[str]) -> str | None:
+        request = turn_packet.get("request")
+        request_player = request.get("player_id") if isinstance(request, Mapping) else ""
+        self_id = str(turn_packet.get("self", {}).get("player_id") or request_player or "")
+        if not self_id:
+            return None
+        target_aliases = {target_id.lstrip("pP"): target_id for target_id in legal_targets}
+        target_pattern = "|".join(re.escape(alias) for alias in target_aliases)
+        if not target_pattern:
+            return None
+        patterns = [
+            re.compile(rf"(?:主票|归票|主压|今天出|今天投|票给|统一出|统一票)\s*(?:压|打|出|投|给|是|为)?\s*(?:p|P|号)?({target_pattern})(?:号)?"),
+            re.compile(rf"(?:p|P|号)?({target_pattern})(?:号)?\s*(?:是今天主票|为今天主票|作为主票|出局)"),
+        ]
+        found: list[str] = []
+        for entry in TaskAgent._dialogue_entries(turn_packet):
+            if TaskAgent._entry_player_id(entry) != self_id:
+                continue
+            text = TaskAgent._entry_text(entry)
+            for pattern in patterns:
+                for match in pattern.findall(text):
+                    target = target_aliases.get(str(match).lstrip("pP"))
+                    if target in legal_targets:
+                        found.append(target)
+        unique = list(dict.fromkeys(found))
+        return unique[0] if len(unique) == 1 else None
+
+    @staticmethod
+    def _trusted_badge_targets(turn_packet: Mapping[str, Any], candidates: list[str]) -> list[str]:
+        if not candidates:
+            return []
+        self_id = str(turn_packet.get("self", {}).get("player_id") or turn_packet.get("request", {}).get("player_id") or "")
+        score = {target_id: 0 for target_id in candidates}
+        for entry in TaskAgent._dialogue_entries(turn_packet):
+            speaker = TaskAgent._entry_player_id(entry)
+            if speaker not in score:
+                continue
+            text = TaskAgent._entry_text(entry)
+            if self_id and re.search(rf"(?:站边|认|信|跟)\s*(?:p|P)?{re.escape(self_id.lstrip('p'))}(?:号)?", text):
+                score[speaker] += 2
+            if re.search(r"(?:我是好人|平民|民牌|听预言家归票|跟预言家)", text):
+                score[speaker] += 1
+        ordered = sorted(candidates, key=lambda target_id: (-score[target_id], candidates.index(target_id)))
+        return [target_id for target_id in ordered if score[target_id] > 0]
 
