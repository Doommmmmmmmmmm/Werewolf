+    def _day_shield_context(
+        self,
+        turn_packet: Mapping[str, Any],
+        memory_snapshot: Mapping[str, Any],
+        current_dialogue: list[dict[str, Any]],
+        current_digest: Mapping[str, Any],
+        candidates: list[str] | None = None,
+        records: Mapping[str, Mapping[str, Any]] | None = None,
+    ) -> dict[str, Any]:
+        """识别单预言家无狼队对跳时不宜裸冲的坐定目标。"""
+        candidate_set = {str(pid) for pid in (candidates or []) if pid is not None}
+        records = records or {}
+        alive_ids = [str(pid) for pid in current_digest.get("alive_player_ids") or []]
+        alive_set = set(alive_ids)
+        wolf_ids = set(self._alive_wolf_ids(turn_packet.get("private_information"), current_digest))
+        if not alive_set or self.player_id in alive_set:
+            wolf_ids.add(self.player_id)
+        text_items: list[tuple[str | None, str]] = []
+        for item in current_dialogue[-6:]:
+            text = item.get("text") or item.get("content") or item.get("message")
+            speaker = item.get("speaker") or item.get("player_id") or item.get("from")
+            if text:
+                text_items.append((str(speaker) if speaker is not None else None, str(text)))
+        for text in self._recent_public_texts[-4:]:
+            text_items.append((None, str(text)))
+
+        seer_claimers: set[str] = set()
+        for pid, record in records.items():
+            claim = self._public_claim_text(record) or ""
+            if "预言家" in claim:
+                seer_claimers.add(str(pid))
+        for speaker, text in text_items:
+            if speaker and "预言家" in text and not any(word in text for word in ("不是预言家", "非预言家")):
+                seer_claimers.add(speaker)
+
+        wolf_seer_claimers = seer_claimers & wolf_ids
+        single_seer_no_wolf_jump = bool(seer_claimers) and not wolf_seer_claimers
+
+        sheriff_id = current_digest.get("current_sheriff_id")
+        shielded: set[str] = set()
+        gold_water: set[str] = set()
+        if single_seer_no_wolf_jump:
+            if sheriff_id is not None:
+                shielded.add(str(sheriff_id))
+            shielded.update(seer_claimers)
+            for speaker, text in text_items:
+                if seer_claimers and speaker not in seer_claimers and "金水" not in text:
+                    continue
+                if not any(word in text for word in ("金水", "好人", "验了")):
+                    continue
+                for pid in candidate_set or alive_set:
+                    if pid and pid in text and pid not in seer_claimers:
+                        gold_water.add(pid)
+            shielded.update(gold_water)
+        if candidate_set:
+            shielded &= candidate_set
+        if alive_set:
+            shielded &= alive_set
+        wolf_alive = len(wolf_ids)
+        nonwolf_alive = len([pid for pid in alive_set if pid not in wolf_ids])
+        if wolf_alive and nonwolf_alive and wolf_alive >= nonwolf_alive:
+            shielded.clear()
+        return {
+            "single_seer_no_wolf_counterclaim": single_seer_no_wolf_jump,
+            "seer_claimers": sorted(seer_claimers),
+            "gold_water_ids": sorted(gold_water),
+            "shielded_target_ids": sorted(shielded),
+            "wolf_vote_majority": bool(wolf_alive and nonwolf_alive and wolf_alive >= nonwolf_alive),
+            "note": "单预无人对跳且未到狼队票权终局时避让持徽预言家/金水，优先压外置位争议非狼",
         }
 
