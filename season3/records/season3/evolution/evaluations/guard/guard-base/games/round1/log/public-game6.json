    {
      "seq": 291,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p5",
        "text": "我是真预言家，验人账本只有三条：p7金水、p8金水、p1查杀。p8翻出猎人和我验的一致，请照这条对。今天把我推出去，正是p1那条线的收益，别被他接徽链的说法带偏。我本想下一步验发言最活、身份未定的位置，没来得及出结果，不是藏票。p7是我给过金水的人可作参照，主票请压p1，别给警徽留面子；好人再分票就是送狼。",
        "death_index": 4,
        "eligible_death_index": 2,
        "trigger_phase": "day_vote"
      }
