    {
      "seq": 104,
      "type": "DAY_SPEECH_ORDER_SET",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "round": 1,
        "reference_seat": 5,
        "reference_is_dawn_death": true,
        "direction": "previous",
        "speaker_ids": [
          "p4",
