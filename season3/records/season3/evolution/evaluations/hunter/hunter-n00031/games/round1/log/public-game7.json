    {
      "seq": 99,
      "type": "DAY_SPEECH_ORDER_SET",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "round": 1,
        "reference_seat": 6,
        "reference_is_dawn_death": true,
        "direction": "previous",
        "speaker_ids": [
          "p5",
          "p4",
