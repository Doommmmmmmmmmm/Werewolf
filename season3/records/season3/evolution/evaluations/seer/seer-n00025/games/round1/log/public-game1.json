    {
      "seq": 211,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p10",
        "text": "我是闭眼平民，不跳强神。目前公开台账只确认存活p2，没有清晰查验链或警徽链，投票记录也不足以指认具体狼坑。若后续仍有发言位，请先核对p2的公开行为与票型，再判断是否有人借遗言带节奏；我这里不能凭空补夜间信息。",
        "death_index": 4,
