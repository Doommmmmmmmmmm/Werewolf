    {
      "seq": 157,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p8",
        "text": "我是猎人，翻牌属实。枪我压下了：当时没有第二源硬证据，不盲带好人，警徽给了p2。理由很简单，10、11、12三段“报民+无夜间信息+齐点6、7”句式同构，是今天唯一能落地的公开证据，p1、p2都认。那把我这个警长兼猎人推出去的票，发起者和跟票的重点查：10、11、12，还有开口就咬我“握着徽没排坑”的那两位。6、7若只是被带节奏，先看你们今天实际票型再定性。别散票，顺着票链走。",
        "death_index": 2,
        "eligible_death_index": 1,
        "trigger_phase": "day_vote"
      }
    },
