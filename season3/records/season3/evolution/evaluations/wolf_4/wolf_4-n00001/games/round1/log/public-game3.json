      }
    },
    {
      "seq": 216,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p9",
        "text": "遗言只留公开信息：p5自报预言家、给p7金水，如今两人都已出局，这条查验链事实上断了；p4持警徽是系统事件。今天集中踩我的票，发言高度雷同的正是p10、p11、p12，三人都拿“警徽流不是查杀”替p1解套，却没人给出替代狼坑。请p1、p2、p3、p8把立场说清，谁继续躲票型我先记在谁头上。别把票再交给抱团话术。",
        "death_index": 4,
