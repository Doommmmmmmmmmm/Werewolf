+        )
+        pressure_patterns = (
+            "查杀", "是狼", "狼坑", "票", "投", "归", "出", "抗推", "压票",
+            "点名", "怀疑", "站边", "警徽流", "焦点",
+        )
+        kill_patterns = (
+            "刀", "砍", "夜里", "晚上", "今晚", "明晚", "先刀", "刀口", "吃刀",
+            "狼刀", "威胁", "留不住", "保护", "守一下",
+        )
+
+        if speaker_id and any(pattern in text for pattern in claim_patterns):
