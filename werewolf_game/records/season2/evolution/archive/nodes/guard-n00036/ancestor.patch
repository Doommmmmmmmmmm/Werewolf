+    def _extract_ids_near_keywords(self, packet: Mapping[str, Any] | Any, keywords: tuple[str, ...]) -> set[str]:
+        nearby_ids: set[str] = set()
+        if not isinstance(packet, Mapping):
+            return nearby_ids
+        for key, value in packet.items():
+            key_text = str(key).lower()
+            value_text = value.lower() if isinstance(value, str) else ""
+            matched = any(keyword in key_text for keyword in keywords) or any(
+                keyword in value_text for keyword in keywords
+            )
+            if matched:
+                nearby_ids.update(self._extract_player_ids(value))
+            if isinstance(value, Mapping):
+                nearby_ids.update(self._extract_ids_near_keywords(value, keywords))
+            elif isinstance(value, list):
+                for item in value:
+                    if matched:
+                        nearby_ids.update(self._extract_player_ids(item))
+                    if isinstance(item, Mapping):
+                        nearby_ids.update(self._extract_ids_near_keywords(item, keywords))
+        return nearby_ids
+
+    def _guard_text_claims_guard(self, text: str) -> bool:
+        normalized = text.replace(" ", "")
+        return any(marker in normalized for marker in ("我是守卫", "跳守卫", "守卫", "guard", "我守卫"))
+
