+    def _guard_self_target_bonus(
+        self,
+        candidates: list[str],
+        risk_scores: Mapping[str, int],
+        round_no: int | None,
+    ) -> int:
+        if self.player_id not in candidates:
+            return 0
+        self_risk = int(risk_scores.get(self.player_id, 0))
+        external_best = max(
+            (int(risk_scores.get(candidate, 0)) for candidate in candidates if candidate != self.player_id),
+            default=None,
+        )
+        bonus = 0
+        if external_best is None:
+            bonus += 3
+        else:
+            gap = external_best - self_risk
+            if gap <= 0:
+                bonus += 3
+            elif gap == 1:
+                bonus += 2
+            elif gap == 2:
+                bonus += 1
+        if round_no is not None and round_no <= 2:
+            bonus += 1
+        if self.last_protected_id == self.player_id:
+            bonus += 1
+        return bonus
+
