+    def _extract_evidence_lines(self, text: str) -> list[str]:
+        if not text:
+            return []
+        lines: list[str] = []
+        for line in text.splitlines():
+            stripped = line.strip()
+            if not stripped:
+                continue
+            if any(token in stripped for token in ("votes=", "conflicts=", "deaths=", "claims=", "confirmed=", "票型", "争议", "死亡", "身份")):
+                lines.append(stripped)
+        return lines[:3]
