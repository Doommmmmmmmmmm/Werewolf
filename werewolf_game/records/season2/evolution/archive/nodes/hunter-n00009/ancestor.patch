+    def _extract_controversy(self, memory_summary: str) -> str:
+        for label in ("controversy=", "conflicts=", "votes=", "claims="):
+            index = memory_summary.find(label)
+            if index >= 0:
+                tail = memory_summary[index + len(label):]
