+    def _infer_memory_kind(self, flat: Mapping[str, str], text: str) -> str:
+        kind = str(flat.get("kind") or flat.get("event") or "").lower()
+        text_lower = text.lower()
+        if any(token in text_lower for token in ("vote", "投票", "冲票", "带票", "票型", "高票")):
