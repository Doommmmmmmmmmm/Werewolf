+                return allowed_kind
+        if targetless_kinds:
+            return targetless_kinds[0]
+        if len(allowed_kinds) == 1 and allowed_kinds[0].lower() in _PASS_KIND_ALIASES:
+            return allowed_kinds[0]
+    return normalized
+
