+    @staticmethod
+    def _unique_tail(values: list[str], limit: int) -> list[str]:
+        if limit <= 0:
+            return []
+        seen: list[str] = []
+        for value in values[-(limit * 2) :]:
+            if value and value not in seen:
+                seen.append(value)
+        return seen[-limit:]
 
