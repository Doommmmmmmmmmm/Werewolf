+            return ""
+        claim_markers = ("我是", "我跳", "我认", "我报", "自称", "claim", "报身份", "身份是")
+        if not any(marker in text for marker in claim_markers):
+            return ""
+        for role in ("预言家", "女巫", "猎人", "守卫", "白痴", "狼人", "村民", "平民", "警长", "好人"):
+            if role in text:
+                return role
+        return ""
