+        )
+        if not candidate_ids:
+            return []
+        evidence_words = {
+            "hard_accuse": ("查杀", "点杀", "验杀", "狼", "狼人", "匪"),
+            "support": ("金水", "好人", "支持", "站边", "保", "护"),
+            "pressure": ("怀疑", "投", "票", "出", "打", "踩", "对跳"),
+            "conflict": ("改口", "矛盾", "反水", "自相矛盾"),
