+    def _observe_decision_context(self, turn_packet: Mapping[str, Any]) -> None:
+        """保存本次决策点已经可见的少量公开信息。
+
+        这里只接收 turn_packet 内的 dialogue 和公开状态；不读取工具之外的历史，
+        也不把原始对话无限累积。发言及其身份/查验说法另标为 claim，不能冒充事实。
+        """
