+    def _public_state_players(self, public_state: Mapping[str, Any]) -> list[Mapping[str, Any]]:
+        raw = None
+        for key in ("players", "player_states", "participants", "users"):
+            candidate = public_state.get(key)
+            if isinstance(candidate, (list, Mapping)):
+                raw = candidate
+                break
+        if isinstance(raw, list):
+            return [item for item in raw if isinstance(item, Mapping)]
+        if isinstance(raw, Mapping):
+            result: list[Mapping[str, Any]] = []
+            for player_id, item in raw.items():
+                if isinstance(item, Mapping):
+                    merged = dict(item)
