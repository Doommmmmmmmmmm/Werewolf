+    def _timeline_entry(self, entry: Mapping[str, Any]) -> dict[str, Any]:
+        claim_text = self._stringify(entry.get("claim") or entry.get("summary"))
+        normalized = {
+            "round": self._stringify(entry.get("round")),
+            "phase": self._stringify(entry.get("phase")),
+            "speaker": self._stringify(entry.get("speaker")),
+            "target": self._stringify(entry.get("target")),
+            "claim": self._truncate_text(claim_text, _SUMMARY_TEXT_LIMIT),
+            "source": self._stringify(entry.get("source")),
+        }
+        summary_text = self._stringify(entry.get("summary"))
+        if summary_text:
+            normalized["summary"] = self._truncate_text(summary_text, _SUMMARY_TEXT_LIMIT)
+        alive_value = entry.get("alive")
+        if alive_value is not None:
+            normalized["alive"] = bool(alive_value)
+        return normalized
+
+    def _dedupe_timeline(self, values: list[dict[str, Any]]) -> list[dict[str, Any]]:
+        seen: set[tuple[str, str, str, str, str]] = set()
+        deduped: list[dict[str, Any]] = []
+        for item in values:
+            if not isinstance(item, Mapping):
+                continue
+            normalized = self._timeline_entry(item)
+            key = (
+                normalized.get("round", ""),
+                normalized.get("phase", ""),
+                normalized.get("speaker", ""),
+                normalized.get("target", ""),
+                normalized.get("claim", ""),
+                normalized.get("summary", ""),
+            )
+            if key in seen:
+                continue
+            seen.add(key)
+            deduped.append(normalized)
+        return deduped
+
+    def _update_vote_timeline(
+        self,
+        packet: Mapping[str, Any],
+        vote_value: Any,
+        vote_summary: str,
+        vote_detail: dict[str, Any],
+    ) -> None:
+        if vote_value is None and not vote_summary and not vote_detail:
+            return
+        round_no = self._seer_memory.round_no
+        phase = self._seer_memory.phase
+        targets = self._extract_player_ids(vote_value)
+        if not targets:
+            targets = self._extract_player_ids(vote_detail)
+        target = targets[0] if targets else ""
+        if not target and vote_summary:
+            target = self._extract_single_player_id(vote_summary)
+        entry = {
+            "round": round_no,
+            "phase": phase,
+            "target": target,
+            "summary": self._truncate_text(vote_summary, _SUMMARY_TEXT_LIMIT),
+            "source": "packet_vote",
+        }
+        if entry["target"] or entry["summary"]:
+            self._seer_memory.vote_timeline.append(self._timeline_entry(entry))
+            self._seer_memory.vote_timeline = self._dedupe_timeline(self._seer_memory.vote_timeline)
+
+    def _refresh_alive_inspection_map(self) -> None:
+        alive = set(self._seer_memory.alive)
+        refreshed: dict[str, dict[str, Any]] = {}
+        for item in self._seer_memory.inspected:
+            if not isinstance(item, Mapping):
+                continue
+            target = self._stringify(item.get("target"))
+            if not target or target not in alive:
+                continue
+            refreshed[target] = self._timeline_entry(item)
+            refreshed[target]["alive"] = True
+        self._seer_memory.alive_inspection_map = refreshed
+
+    def _refresh_pressure_target(self, turn_packet: Mapping[str, Any]) -> None:
+        alive = set(self._seer_memory.alive)
+        pool: list[str] = []
+        pool.extend(self._seer_memory.challenged_players)
+        pool.extend(self._seer_memory.sheriff_candidates)
+        if self._seer_memory.sheriff_id:
+            pool.append(self._seer_memory.sheriff_id)
+        for item in self._seer_memory.claim_timeline[-_SUMMARY_LIST_LIMIT:]:
+            if isinstance(item, Mapping):
+                pool.extend([self._stringify(item.get("target")), self._stringify(item.get("speaker"))])
+        for item in self._seer_memory.vote_timeline[-_SUMMARY_LIST_LIMIT:]:
+            if isinstance(item, Mapping):
+                pool.append(self._stringify(item.get("target")))
+        pool = [target for target in self._unique_stable(pool) if target and target != self.player_id]
+        scored: list[tuple[int, int, str]] = []
+        for index, target in enumerate(pool):
+            if target not in alive:
+                continue
+            score = 0
+            if target == self._seer_memory.current_pressure_target:
+                score += 40
+            if target in self._seer_memory.challenged_players:
+                score += 35
+            if self._has_public_claim_conflict(target):
+                score += 30
+            if target in self._seer_memory.sheriff_candidates or target == self._seer_memory.sheriff_id:
+                score += 20
+            if target in self._seer_memory.alive_inspection_map:
+                score += 15
+            if self._appears_in_recent_vote(target):
+                score += 15
+            score += max(0, 10 - index)
+            scored.append((score, -index, target))
+        if scored:
+            scored.sort(reverse=True)
+            self._seer_memory.current_pressure_target = scored[0][2]
+        elif self._seer_memory.current_pressure_target not in alive:
+            self._seer_memory.current_pressure_target = ""
+
+    def _refresh_last_public_fact(self) -> None:
+        candidates = list(self._seer_memory.inspected[-1:])
+        if not candidates and self._seer_memory.claim_timeline:
+            candidates.append(self._seer_memory.claim_timeline[-1])
+        if not candidates and self._seer_memory.vote_timeline:
+            candidates.append(self._seer_memory.vote_timeline[-1])
+        if candidates:
+            entry = candidates[-1]
+            round_no = self._stringify(entry.get("round"))
+            target = self._stringify(entry.get("target"))
+            claim = self._stringify(entry.get("claim") or entry.get("summary"))
+            if target and claim:
+                prefix = f"{round_no + '轮' if round_no else '近期'}"
+                self._seer_memory.last_public_fact = f"{prefix}{target}:{claim}"
+                return
+        if self._seer_memory.recent_vote_summary:
+            self._seer_memory.last_public_fact = f"最近票型：{self._seer_memory.recent_vote_summary}"
+        elif self._seer_memory.inspected:
+            latest = self._seer_memory.inspected[-1]
+            self._seer_memory.last_public_fact = self._inspection_fact_text(latest)
+        else:
+            self._seer_memory.last_public_fact = ""
+
+    def _has_public_claim_conflict(self, target_id: str) -> bool:
+        if not target_id:
+            return False
+        claimed = False
+        challenged = False
+        for item in self._seer_memory.claim_timeline:
+            if not isinstance(item, Mapping):
+                continue
+            speaker = self._stringify(item.get("speaker"))
+            target = self._stringify(item.get("target"))
+            if target_id in {speaker, target}:
+                claimed = True
+                if self._stringify(item.get("source")) in {"challenge", "packet_challenge"}:
+                    challenged = True
+        voted = self._appears_in_recent_vote(target_id)
+        return (claimed and voted) or challenged
+
+    def _inspection_fact_text(self, item: Mapping[str, Any]) -> str:
