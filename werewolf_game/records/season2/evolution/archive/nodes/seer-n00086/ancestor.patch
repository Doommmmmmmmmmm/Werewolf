+    # Common packets use p6/p11. This fallback is only a label extractor, not a source of facts.
+    for pid in re.findall(r"(?<![A-Za-z0-9_])p\d+(?![A-Za-z0-9_])", text, re.IGNORECASE):
+        if pid not in found:
+            found.append(pid)
+    return found[:6]
