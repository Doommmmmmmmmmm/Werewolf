+def _ids_in_text(text: str, known_ids: set[str]) -> list[str]:
+    found: list[str] = []
+    for pid in sorted(known_ids):
+        if re.search(r"(?<![A-Za-z0-9_])" + re.escape(pid) + r"(?![A-Za-z0-9_])", text, re.IGNORECASE):
