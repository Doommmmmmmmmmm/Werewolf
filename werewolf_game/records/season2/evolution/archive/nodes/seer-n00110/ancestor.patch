+                    if key in {"events", "event", "event_list", "event_log", "audit_events", "public_events", "sync", "data", "payload"}:
+                        walk(nested)
+            elif isinstance(value, list):
+                for item in value:
+                    walk(item)
+
+        walk(packet)
+        return events
