+    def _repair_seer_action(
+        self, action: dict[str, Any], request: Mapping[str, Any]
+    ) -> dict[str, Any]:
+        """Repair only an illegal/repeated night check, never public text."""
+        if action.get("kind") != "seer_inspect":
+            return action
+        allowed: list[str] = []
+        for item in request.get("allowed_actions", []):
+            if isinstance(item, Mapping) and item.get("kind") == "seer_inspect":
+                ids = item.get("target_ids")
+                if isinstance(ids, list):
+                    allowed = [str(x) for x in ids]
+                break
+        if not allowed:
+            return action
+        already = {str(x.get("target_id")) for x in self._seer_state["inspection_ledger"]}
+        candidate = str(action.get("target_id", ""))
+        if candidate in allowed and candidate not in already:
+            return action
+        fresh = [target for target in allowed if target not in already]
+        pressure = str(self._seer_state.get("current_pressure_target") or "")
+        replacement = pressure if pressure in fresh else (fresh[0] if fresh else "")
+        if replacement:
+            repaired = dict(action)
+            repaired["target_id"] = replacement
+            return repaired
+        if any(item.get("kind") == "pass" for item in request.get("allowed_actions", []) if isinstance(item, Mapping)):
+            return {"request_id": request.get("request_id"), "player_id": self.player_id, "kind": "pass"}
+        return action
