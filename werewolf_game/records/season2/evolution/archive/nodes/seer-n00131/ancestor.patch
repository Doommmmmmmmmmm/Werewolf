+_PUBLIC_SIGNAL_LIMITS = {
+    "claimants": 8,
+    "claimed_inspections": 10,
+    "pressure": 12,
+    "votes": 10,
+    "snippets": 6,
+}
+
+
+def _bounded_public_text(value: Any, limit: int = 120) -> str:
+    text = str(value or "").replace("\\n", " ").strip()
+    return text[:limit]
+
+
+def _known_ids_from_context(known_ids: Any) -> list[str]:
+    return list(dict.fromkeys(str(pid) for pid in _extract_id_list(known_ids) if str(pid)))
+
+
+def _signal_ids(text: str, known_ids: list[str]) -> list[str]:
+    # 只接受当前公开状态已经出现的玩家 id，避免自然语言中的数字被误当玩家。
+    return [pid for pid in known_ids if re.search(rf"(?<![A-Za-z0-9]){re.escape(pid)}(?![A-Za-z0-9])", text, re.I)]
+
+
+def _extract_public_vote_claim_signals(public_state: Mapping[str, Any] | None) -> dict[str, list[dict[str, Any]]]:
+    """从公开字段提取小型信号集；这些永远不是查验事实。"""
+    if not isinstance(public_state, Mapping):
+        return {"claimants": [], "claimed_inspections": [], "pressure": [], "votes": [], "snippets": []}
+    known_ids = _known_ids_from_context(
+        public_state.get("alive_player_ids") or public_state.get("alive_players")
+        or public_state.get("players") or public_state.get("current_players")
+    )
+    result: dict[str, list[dict[str, Any]]] = {key: [] for key in _PUBLIC_SIGNAL_LIMITS}
+
+    def add(bucket: str, item: dict[str, Any]) -> None:
+        if len(result[bucket]) < _PUBLIC_SIGNAL_LIMITS[bucket] and item not in result[bucket]:
+            result[bucket].append(item)
+
+    def visit(value: Any, key_hint: str = "") -> None:
+        hint = key_hint.lower()
+        if isinstance(value, Mapping):
+            speaker = _as_str_id(value.get("speaker_id") or value.get("player_id") or value.get("voter") or value.get("from"))
+            target = _as_str_id(value.get("target_id") or value.get("target") or value.get("vote_target") or value.get("to"))
+            if speaker and target and any(token in hint for token in ("vote", "ballot", "投票", "归票")):
+                add("votes", {"from": speaker, "target": target, "source": "public_state"})
+            if speaker and any(token in hint for token in ("claim", "role_claim", "身份声明", "对跳")):
+                role = _bounded_public_text(value.get("role") or value.get("claim") or value.get("claimed_role"), 40)
+                add("claimants", {"player_id": speaker, "claim": role or "公开身份声明"})
+            for key, nested in value.items():
+                visit(nested, str(key))
+        elif isinstance(value, (list, tuple, set)):
+            for nested in value:
+                visit(nested, hint)
+    visit(public_state)
+    return result
+
+
+def _summarize_current_dialogue(
+    dialogue: Any,
+    known_ids: Any,
+) -> dict[str, list[dict[str, Any]]]:
+    """把当前轮可见发言压成有界公开信号，不保存完整对话。"""
+    ids = _known_ids_from_context(known_ids)
+    result: dict[str, list[dict[str, Any]]] = {key: [] for key in _PUBLIC_SIGNAL_LIMITS}
+    if not isinstance(dialogue, (list, tuple)):
+        return result
+
+    def add(bucket: str, item: dict[str, Any]) -> None:
+        if len(result[bucket]) < _PUBLIC_SIGNAL_LIMITS[bucket] and item not in result[bucket]:
+            result[bucket].append(item)
+
+    for entry in list(dialogue)[-12:]:
+        if isinstance(entry, Mapping):
+            speaker = _as_str_id(entry.get("speaker_id") or entry.get("player_id") or entry.get("speaker") or entry.get("from"))
+            text = _bounded_public_text(entry.get("text") or entry.get("content") or entry.get("message") or entry.get("speech"))
+        else:
+            speaker, text = None, _bounded_public_text(entry)
+        if not text:
+            continue
+        found = _signal_ids(text, ids)
+        low = text.lower()
+        role_claim = any(token in low for token in ("seer", "fortune teller", "预言家", "真预", "跳预"))
+        if speaker and role_claim:
+            add("claimants", {"player_id": speaker, "claim": "seer"})
+        inspection_words = ("查杀", "金水", "验人", "查验", "查了", "验了", "昨晚验", "check", "checked")
+        if role_claim and any(word in low for word in inspection_words):
+            for target in found[:3]:
+                match = re.search(rf"(?<![A-Za-z0-9]){re.escape(target)}(?![A-Za-z0-9])", text, re.I)
+                window = text[max(0, (match.start() if match else 0) - 10):(match.end() if match else len(text)) + 10]
+                alignment = "wolf" if any(x in window for x in ("查杀", "wolf", "狼人")) else ("village" if any(x in window for x in ("金水", "好人", "villager", "村民")) else "claimed")
+                add("claimed_inspections", {"claimant": speaker or "unknown", "target": target, "claimed_result": alignment})
+        vote_words = ("投", "归票", "主投", "票给", "vote", "voting")
+        pressure_words = ("保", "保护", "站", "踩", "质疑", "怀疑", "打", "攻击", "push", "suspect")
+        for target in found[:4]:
+            if any(word in low for word in vote_words):
+                add("votes", {"from": speaker or "unknown", "target": target, "source": "dialogue"})
+            if any(word in low for word in pressure_words):
+                label = "protect" if any(word in low for word in ("保", "保护", "站", "defend")) else "attack"
+                add("pressure", {"from": speaker or "unknown", "target": target, "signal": label})
+        if speaker:
+            add("snippets", {"speaker": speaker, "text": text})
+    return result
+
+
+def _extract_public_commitments(text: str, known_ids: Any) -> dict[str, str | None]:
+    ids = _known_ids_from_context(known_ids)
+    if not text:
+        return {"next_inspect": None, "badge_plan": None, "main_vote": None}
+
+    def after(words: tuple[str, ...]) -> str | None:
+        positions = [text.lower().find(word.lower()) for word in words]
+        positions = [pos for pos in positions if pos >= 0]
+        if not positions:
+            return None
+        tail = text[min(positions):]
+        found = _signal_ids(tail, ids)
+        return found[0] if found else None
+
+    return {
+        "next_inspect": after(("下一验", "下验", "next check")),
+        "badge_plan": after(("警徽给", "警徽交", "警徽传", "徽给", "badge to")),
+        "main_vote": after(("主投", "归票", "投", "vote")),
+    }
+
+
+def _merge_public_signals(*signals: Mapping[str, Any] | None) -> dict[str, list[dict[str, Any]]]:
+    merged: dict[str, list[dict[str, Any]]] = {key: [] for key in _PUBLIC_SIGNAL_LIMITS}
+    for signal in signals:
+        if not isinstance(signal, Mapping):
+            continue
+        for key, limit in _PUBLIC_SIGNAL_LIMITS.items():
+            values = signal.get(key)
+            if not isinstance(values, list):
+                continue
+            for value in values:
+                if isinstance(value, Mapping) and value not in merged[key] and len(merged[key]) < limit:
+                    merged[key].append(dict(value))
+    return merged
+
