+    def _speech_inspection_error(self, text: str, authoritative: Mapping[str, str]) -> str | None:
+        """校验模型把自己的查验链说成了什么；对手的声明不纳入校验。"""
+        if not text or not authoritative:
+            return None
+        result_patterns = (
+            (re.compile(r"查杀|狼人?|坏人|wolf|werewolf", re.IGNORECASE), "wolf"),
+            (re.compile(r"金水|好人|村民|平民|villager|good|human", re.IGNORECASE), "villager"),
+        )
+        # 按标点分段，避免把“对方报 p2 查杀，我验 p3 狼”混成一条声明。
+        clauses = re.split(r"[。！？!?；;，,、]+", text)
+        self_markers = re.compile(r"(?:我|本人|咱|昨晚|上一晚).{0,8}(?:验|查|查验)|查验链|我的查验", re.IGNORECASE)
+        other_markers = re.compile(r"对方|他人|他说|声称|报验|假预言家|对跳者|狼悍跳|别人", re.IGNORECASE)
+        player_pattern = re.compile(r"p\d+|第\s*\d{1,2}\s*[号位]", re.IGNORECASE)
+        for clause in clauses:
+            if not clause or not self_markers.search(clause) or other_markers.search(clause):
+                continue
+            ids = self._extract_player_ids(clause)
+            if not ids:
+                # 只有查验链上下文才允许使用座位称呼；别的模糊话术不拦截。
+                ids = [self._extract_single_player_id(match.group(0)) for match in player_pattern.finditer(clause)]
+                ids = [item for item in ids if item]
+            result = next((normalized for pattern, normalized in result_patterns if pattern.search(clause)), "")
+            if not result:
+                continue
+            for target in self._unique_stable(ids):
+                expected = authoritative.get(target)
+                if expected is None:
+                    allowed = "、".join(f"{key}={value}" for key, value in authoritative.items())
+                    return f"发言声称自己查验了未收到的目标 {target}；只能使用权威查验链：{allowed}"
+                if expected != result:
