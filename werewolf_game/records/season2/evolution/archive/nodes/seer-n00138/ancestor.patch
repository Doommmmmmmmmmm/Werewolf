+    def _speech_fact_error(self, text: str) -> str | None:
+        """拦截少数高风险的虚构声明，不干预普通怀疑和要求表态。"""
+        if not text:
+            return None
+
+        def resolve(reference: str) -> str:
+            ids = self._extract_player_ids_from_text(reference)
+            return ids[0] if ids else reference.lower()
+
+        # “pX 跳/也跳预言家”以及“pX 报 pY 金水/查杀/验了 pY”均属于强事实。
+        seer_jump = re.compile(
+            r"(?P<speaker>p\d+|第?\d{1,2}[号位]?)\s*(?:跳\s*预言家|"
+            r"也\s*跳(?=\s*(?:预言家|[，。！？；,.!?]|$))|"
+            r"自称\s*预言家|声称\s*预言家|报身份为?\s*预言家)"
+        )
+        report = re.compile(
+            r"(?P<speaker>p\d+|第?\d{1,2}[号位]?)\s*(?:也\s*)?(?:报|说|称)\s*"
+            r"(?P<target>p\d+|第?\d{1,2}[号位]?)\s*(?P<result>金水|查杀|狼|好人)"
+        )
+        checked = re.compile(
+            r"(?P<speaker>p\d+|第?\d{1,2}[号位]?)\s*(?:昨晚)?(?:验了|验过|查了|查验了)\s*"
+            r"(?P<target>p\d+|第?\d{1,2}[号位]?)\s*(?P<result>金水|查杀|狼|好人)?"
+        )
+        known_claimers = set(self._seer_memory.verified_seer_claimers)
+        for claim_entry in self._seer_memory.declared_claims:
+            if not isinstance(claim_entry, Mapping):
+                continue
+            speaker = self._stringify(claim_entry.get("speaker")).strip()
+            claim = self._stringify(claim_entry.get("claim"))
+            if speaker and any(marker in claim for marker in ("预言家", "我验", "我查", "查验", "查杀", "金水")):
+                known_claimers.add(speaker)
+        for pattern in (seer_jump, report, checked):
+            for match in pattern.finditer(text):
+                speaker = resolve(match.group("speaker"))
+                if speaker == self.player_id or speaker in known_claimers:
+                    continue
+                return f"不能把未在公开记录确认的 {speaker} 说成已跳预言家或已报查验；请改为‘我怀疑/我要求其表态’"
+
+        self_check = re.compile(
+            r"我\s*(?:昨晚)?(?:验了|验过|查了|查验了|验|查)\s*"
+            r"(?P<target>p\d+|第?\d{1,2}[号位]?)\s*(?P<result>金水|查杀|狼|好人)"
+        )
+        inspected = {
+            self._stringify(item.get("target")): self._inspection_result_text(item.get("result"))
+            for item in self._seer_memory.inspected
+            if isinstance(item, Mapping)
+        }
+        for match in self_check.finditer(text):
+            target = resolve(match.group("target"))
+            raw_result = match.group("result")
+            result = "wolf" if raw_result in {"查杀", "狼"} else "villager"
+            if inspected.get(target) != result:
+                return "只能公开自己实际收到的查验结果；目标和金水/查杀必须与 seer_memory.inspected 完全一致"
+        return None
+
+    def _record_verified_seer_claimer(self, speaker: str, claim: str) -> None:
+        speaker = self._stringify(speaker).strip()
+        claim = self._stringify(claim)
+        if not speaker or not claim:
+            return
+        strong_markers = ("预言家", "我验", "我查", "查验", "查杀", "金水")
+        if any(marker in claim for marker in strong_markers):
+            self._seer_memory.verified_seer_claimers = self._unique_stable(
+                list(self._seer_memory.verified_seer_claimers) + [speaker]
+            )[-_SUMMARY_LIST_LIMIT:]
 
