+        self._public_ledger = {
+            "alive_ids": set(),
+            "dead_ids": set(),
+            "known_player_ids": set(),
+            "recent_events": [],
+            "public_claims": [],
+            "vote_snapshots": [],
+            "sheriff_changes": [],
+            "badge_transfers": [],
+            "death_notices": [],
+        }
