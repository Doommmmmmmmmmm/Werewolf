+    def _packet_marker(self, packet: Mapping[str, Any]) -> str:
+        pieces: list[str] = []
+        game = packet.get("game")
+        if isinstance(game, Mapping):
+            round_value = game.get("round")
+            if round_value is not None:
+                pieces.append(f"r{round_value}")
+            phase_value = game.get("public_phase") or game.get("phase")
+            if phase_value:
+                pieces.append(str(phase_value))
+        phase_value = packet.get("phase") or packet.get("channel")
+        if phase_value:
+            phase_text = str(phase_value)
+            if phase_text not in pieces:
+                pieces.append(phase_text)
+        if not pieces:
+            return "snapshot"
+        return "/".join(pieces[:3])
+
+    def _remember_text(self, field: str, label: str, text: str, marker: str) -> None:
+        cleaned = _trim_compact_text(text, limit=240)
+        if not cleaned:
+            return
+        current = str(self._working_memory.get(field) or "").strip()
+        if cleaned == current:
+            return
+        self._working_memory[field] = cleaned
+        event = f"{marker} {label}:{cleaned}" if marker else f"{label}:{cleaned}"
+        events = self._working_memory.setdefault("events", [])
+        if isinstance(events, list) and event not in events:
+            events.append(event)
+            if len(events) > 8:
+                del events[:-8]
+
+    def _rank_suspects(self, public_state: Any) -> list[tuple[str, int]]:
+        scores: dict[str, int] = {}
+
+        def add_from_keys(keys: tuple[str, ...], weight: int, *, max_results: int = 2) -> None:
+            for value in _search_public_values(public_state, keys, max_results=max_results):
+                labels = _collect_compact_labels(value, limit=8)
+                if not labels:
+                    fallback = _format_compact_value(value, limit=4)
+                    if fallback:
+                        labels = [fallback]
+                for label in labels:
+                    scores[label] = scores.get(label, 0) + weight
+
+        add_from_keys(("vote_history", "votes", "ballots", "vote_matrix", "voting"), 3)
+        add_from_keys(("public_claims", "claims", "revealed_roles", "role_claims", "check_log", "checks", "accusations", "suspects"), 2)
+        add_from_keys(("last_words", "death_words", "final_words", "wills"), 1)
+        add_from_keys(("public_suspects", "suspect_order", "suspicion", "suspicious"), 2)
+
+        alive_values = _search_public_values(public_state, ("alive_players", "living_players", "alive", "survivors", "live_players", "living"), max_results=1)
+        alive_labels = _collect_compact_labels(alive_values[0], limit=8) if alive_values else []
+        for label in alive_labels:
+            scores.setdefault(label, 0)
+
+        ranked = sorted(scores.items(), key=lambda item: (-item[1], item[0]))
+        if alive_labels:
+            alive_set = set(alive_labels)
+            alive_ranked = [item for item in ranked if item[0] in alive_set]
+            if len(alive_ranked) >= 2:
+                rest = [item for item in ranked if item[0] not in alive_set]
+                ranked = alive_ranked + rest
+        return ranked
