+def _trim_compact_text(text: str, *, limit: int = 120) -> str:
+    cleaned = " ".join(str(text).split())
+    if len(cleaned) <= limit:
+        return cleaned
+    if limit <= 1:
+        return cleaned[:limit]
+    return cleaned[: limit - 1] + "…"
+
+
+def _summarize_current_round_dialogue(dialogue: Any, *, limit: int = 5) -> str:
+    if not isinstance(dialogue, list) or not dialogue:
+        return ""
+    parts: list[str] = []
+    for item in dialogue[-10:]:
+        if len(parts) >= limit:
+            break
+        if not isinstance(item, Mapping):
+            continue
+        speaker = _player_label(
+            item.get("speaker")
+            or item.get("speaker_id")
+            or item.get("player_id")
+            or item.get("playerId")
+            or item.get("from")
+        )
+        target = _player_label(item.get("target_id") or item.get("targetId") or item.get("target"))
+        text = item.get("text") or item.get("message") or item.get("content") or item.get("speech")
+        if not isinstance(text, str):
+            text = _format_compact_value(text, limit=4)
+        text = _trim_compact_text(text, limit=72)
+        if not text:
+            continue
+        prefix = speaker or "发言"
+        if target:
+            prefix = f"{prefix}->{target}"
+        phase = str(item.get("phase") or item.get("channel") or "").strip()
+        if phase:
+            prefix = f"{phase}:{prefix}"
+        parts.append(f"{prefix}:{text}")
+    return "；".join(parts)
+
