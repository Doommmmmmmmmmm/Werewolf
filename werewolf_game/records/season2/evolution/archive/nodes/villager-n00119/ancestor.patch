+    def _refresh_alive_memory(self, summary: Mapping[str, Any]) -> None:
+        alive = {pid for pid in summary.get("alive_ids", []) if pid}
+        dead = {pid for pid in summary.get("dead_ids", []) if pid}
+        if alive:
+            self._working_memory["alive_ids"] = alive
+        if dead:
+            self._working_memory.setdefault("dead_ids", set()).update(dead)
+        if alive:
+            self._working_memory["dead_ids"] = set(self._working_memory.get("dead_ids", set())) - alive | dead
