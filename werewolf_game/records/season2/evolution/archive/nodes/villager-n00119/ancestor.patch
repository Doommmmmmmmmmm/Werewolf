+    def _accept_public_event(
+        self,
+        kind: str,
+        event: Mapping[str, Any],
+        round_value: Any,
+        phase_value: Any,
+    ) -> bool:
+        speaker = event.get("player_id") or event.get("speaker") or event.get("voter_id")
+        key_parts = [
+            kind,
+            self._compact_text(round_value, 16),
+            self._compact_text(phase_value, 16),
+            self._compact_text(speaker, 24),
+            self._compact_text(event.get("target_id"), 24),
+            self._compact_text(event.get("role_hint"), 24),
+            self._compact_text(event.get("claim_text") or event.get("text") or event, 120),
+        ]
+        digest = hashlib.sha1("|".join(key_parts).encode("utf-8")).hexdigest()
+        seen_set: set[str] = self._working_memory.setdefault("seen_event_key_set", set())
+        if digest in seen_set:
+            return False
+        seen_set.add(digest)
+        seen_keys: list[str] = self._working_memory.setdefault("seen_event_keys", [])
+        seen_keys.append(digest)
+        while len(seen_keys) > 240:
+            old = seen_keys.pop(0)
+            seen_set.discard(old)
+        return True
+
+    def _append_edge_once(self, bucket_name: str, entry: dict[str, Any], *, limit: int = 40) -> bool:
+        bucket = self._working_memory.setdefault(bucket_name, [])
+        key = (
+            entry.get("kind"),
+            entry.get("round"),
+            entry.get("phase"),
+            entry.get("player_id"),
+            entry.get("target_id"),
+        )
+        for existing in bucket:
+            if isinstance(existing, Mapping) and (
+                existing.get("kind"),
+                existing.get("round"),
+                existing.get("phase"),
+                existing.get("player_id"),
+                existing.get("target_id"),
+            ) == key:
+                return False
+        bucket.append(entry)
+        del bucket[:-limit]
+        return True
 
