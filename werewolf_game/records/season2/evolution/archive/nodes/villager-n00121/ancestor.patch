+        lower = {str(key).lower(): key for key in node.keys()}
+        aliases = {
+            "death": ("death", "deaths", "dead", "eliminated", "elimination"),
+            "sheriff": ("sheriff_event", "sheriff", "badge_event", "badge", "captain"),
