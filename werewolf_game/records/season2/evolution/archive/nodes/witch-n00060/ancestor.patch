+                    "vote_pressure": 0,
+                    "claim_conflict": 0,
+                    "death_chain": 0,
+                    "role_chain": 0,
+                    "notes": [],
+                },
+            )
+            entry["score"] = int(entry.get("score", 0)) + weight
+            entry[field_name] = int(entry.get(field_name, 0)) + weight
+            notes = entry.setdefault("notes", [])
