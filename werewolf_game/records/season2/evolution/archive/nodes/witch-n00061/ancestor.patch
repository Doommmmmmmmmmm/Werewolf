+        elif not preferred_target:
+            reason = "no_legal_victim"
+        else:
+            reason = "victim_not_high_value_enough"
+        return {
+            "available": bool(resources.get("antidote_available")),
+            "target_id": preferred_target,
+            "score": preferred_score,
+            "should_heal": should_heal,
+            "reason": reason,
