+    def _count_alive_player_list(self, node: Any) -> int | None:
+        if isinstance(node, Mapping):
+            for key, value in node.items():
+                normalized = self._normalize_field_key(key)
+                if normalized in {"alive_players", "living_players", "remaining_players"} and isinstance(value, list):
+                    return sum(
