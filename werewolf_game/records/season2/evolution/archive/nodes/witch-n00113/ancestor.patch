+    def _extract_exact_player_field(self, node: Any, keys: set[str]) -> str | None:
+        if isinstance(node, Mapping):
+            for key, value in node.items():
+                normalized = self._normalize_field_key(key)
+                if normalized in keys and isinstance(value, str):
+                    match = _PLAYER_ID_PATTERN.fullmatch(value.strip())
+                    if match:
+                        return match.group(0).lower()
+                found = self._extract_exact_player_field(value, keys)
+                if found:
+                    return found
+        elif isinstance(node, list):
+            for item in node:
+                found = self._extract_exact_player_field(item, keys)
+                if found:
+                    return found
+        return None
