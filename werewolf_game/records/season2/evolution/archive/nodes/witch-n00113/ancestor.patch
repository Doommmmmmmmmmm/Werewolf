+    def _extract_private_wolf_attack_targets(
+        self,
+        private: Mapping[str, Any] | Any,
+        turn_packet: Mapping[str, Any] | None = None,
+    ) -> set[str]:
+        """只从私密信息的精确刀口字段读取当夜狼人目标。
+
+        不能从 public_state 或整棵 JSON 的 ``death`` 文本猜当前刀口；那既会把
+        历史死亡混进来，也可能把发言中的玩家编号误当成受害者。
+        """
+        exact_keys = {
+            "wolf_target", "wolf_target_id", "wolf_attack_target", "wolf_attack_target_id",
+            "wolf_kill_target", "wolf_kill_target_id", "attacked_player_id", "victim_id",
+            "night_death_target", "night_death_target_id", "night_kill_target", "night_kill_target_id",
+        }
+        roots: list[Any] = [private]
+        if isinstance(turn_packet, Mapping):
+            private_node = turn_packet.get("private_information")
+            if private_node is not None and private_node is not private:
+                roots.append(private_node)
+        targets: set[str] = set()
+
+        def scalar_ids(value: Any) -> None:
+            if isinstance(value, (list, tuple, set)):
+                for item in value:
+                    scalar_ids(item)
+                return
+            if isinstance(value, str):
+                match = _PLAYER_ID_PATTERN.fullmatch(value.strip())
+                if match:
+                    targets.add(match.group(0).lower())
+            # 精确字段的值若是对象，也只继续寻找对象内的精确字段。
+            elif isinstance(value, Mapping):
+                walk(value)
+
+        def walk(node: Any) -> None:
+            if isinstance(node, Mapping):
+                for key, value in node.items():
+                    normalized = self._normalize_field_key(key)
+                    if normalized in exact_keys:
+                        scalar_ids(value)
+                    elif isinstance(value, (Mapping, list)):
+                        walk(value)
+            elif isinstance(node, list):
+                for item in node:
+                    walk(item)
+
+        for root in roots:
+            walk(root)
+        return targets
+
