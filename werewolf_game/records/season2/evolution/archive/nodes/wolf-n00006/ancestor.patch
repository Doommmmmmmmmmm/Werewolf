+            "dead_players": (
+                "dead_players",
+                "dead",
+                "eliminated_players",
+                ("state", "dead_players"),
+                ("game", "dead_players"),
+            ),
+            "sheriff": (
+                "sheriff",
+                "police",
+                "captain",
+                "leader",
+                ("state", "sheriff"),
+                ("game", "sheriff"),
+            ),
+            "votes": (
+                "votes",
+                "vote",
+                "vote_records",
+                "voting",
+                ("state", "votes"),
+                ("game", "votes"),
+            ),
+            "dialogue": (
+                "dialogue",
+                "public_dialogue",
+                "messages",
+                "events",
+                "announcements",
+                ("state", "dialogue"),
+                ("game", "dialogue"),
