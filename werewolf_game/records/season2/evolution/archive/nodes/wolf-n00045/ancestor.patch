+    def _recent_vote_turn_summaries(self) -> list[dict[str, Any]]:
+        grouped: dict[str, list[str]] = {}
+        round_order: list[str] = []
+        for entry in reversed(self._public_ledger["votes"]):
+            if not isinstance(entry, Mapping):
+                continue
+            round_value = entry.get("round")
+            round_key = str(round_value) if round_value is not None else ""
+            if round_key not in grouped:
+                grouped[round_key] = []
+                round_order.append(round_key)
+            voter = entry.get("voter") or entry.get("player_id")
+            target = entry.get("target_id") or entry.get("vote")
+            if voter is None and target is None:
+                continue
+            grouped[round_key].append(f"{voter}->{target}")
+        summaries: list[dict[str, Any]] = []
+        for round_key in reversed(round_order[:3]):
+            items = grouped.get(round_key) or []
+            if not items:
+                continue
+            summary = "；".join(items[:3])
+            summaries.append({"round": round_key or None, "summary": summary})
+        return summaries[-3:]
