+    def _night_stage_profile(
+        self,
+        turn_packet: Mapping[str, Any],
+        memory_snapshot: Mapping[str, Any],
+    ) -> dict[str, Any]:
+        game = turn_packet.get("game") if isinstance(turn_packet.get("game"), Mapping) else {}
+        alive_players = game.get("alive_players") or memory_snapshot.get("game", {}).get("alive_players") or []
+        dead_players = game.get("dead_players") or memory_snapshot.get("game", {}).get("dead_players") or []
+        alive_count = len(alive_players) if isinstance(alive_players, list) else self._nonnegative_int(game.get("alive_count"), fallback=0) or 0
+        dead_count = len(dead_players) if isinstance(dead_players, list) else self._nonnegative_int(game.get("dead_count"), fallback=0) or 0
+        round_value = self._nonnegative_int(self._safe_get(game, "round"), fallback=0) or 0
+        if alive_count <= 5 or dead_count >= 4 or (round_value >= 5 and alive_count <= 6):
+            stage = "endgame"
+        elif round_value <= 2 and dead_count <= 1:
+            stage = "early"
+        else:
+            stage = "mid"
+        return {
+            "stage": stage,
+            "round": round_value,
+            "alive_count": alive_count,
+            "dead_count": dead_count,
+        }
