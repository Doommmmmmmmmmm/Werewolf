+    def _claimed_role_from_text(self, text: str) -> str | None:
+        role_patterns = (
+            ("seer", r"(?:我是|我才是|跳|自称)\s*(?:真|真正的)?\s*(?:预言家|预言|seer)"),
+            ("guard", r"(?:我是|我才是|跳|自称)\s*(?:真|真正的)?\s*(?:守卫|护卫|guard)"),
+            ("witch", r"(?:我是|我才是|跳|自称)\s*(?:真|真正的)?\s*(?:女巫|witch)"),
+            ("hunter", r"(?:我是|我才是|跳|自称)\s*(?:真|真正的)?\s*(?:猎人|hunter)"),
+            ("villager", r"(?:我是|我才是)\s*(?:真|真正的)?\s*(?:平民|村民|villager)"),
+        )
+        for role, pattern in role_patterns:
+            if re.search(pattern, text, re.IGNORECASE):
+                return role
+        return None
+
+    @staticmethod
+    def _is_hard_claim(text: str) -> bool:
+        return bool(re.search(r"(?:我是|我才是|我跳|明确跳|硬跳|自称)\s*(?:真|真正的)?\s*(?:预言家|守卫|女巫|猎人|平民|村民)", text, re.IGNORECASE))
+
+    def _normalize_player_ref(self, value: Any) -> str:
+        raw = str(value).strip().lower()
+        if raw.endswith("号") and raw[:-1].isdigit():
+            return "p" + raw[:-1]
+        if raw.isdigit():
+            return "p" + raw
+        return raw
+
+    def _normalize_mentioned_ids(self, text: str) -> list[str]:
+        found = re.findall(r"p\d+|(?:\d+)号", text, re.IGNORECASE)
+        result: list[str] = []
+        for value in found:
+            value = value.lower()
+            normalized = value if value.startswith("p") else "p" + value[:-1]
+            if normalized not in result:
+                result.append(normalized)
+        return result[:6]
+
