+    def _repair_illegal_target(
+        self,
+        action: Mapping[str, Any],
+        request: Mapping[str, Any],
+        prompt: Mapping[str, Any],
+    ) -> dict[str, Any] | None:
+        """只修复非法目标，保留模型选择的 kind、文本和请求绑定字段。"""
+
+        allowed = next(
+            (item for item in request.get("allowed_actions", [])
+             if isinstance(item, Mapping) and item.get("kind") == action.get("kind")),
+            None,
+        )
+        if not isinstance(allowed, Mapping):
+            return None
+        valid = [str(item) for item in (allowed.get("target_ids") or []) if item is not None]
+        if not valid:
+            return None
+        state = prompt.get("decision_state", {}) if isinstance(prompt, Mapping) else {}
+        strategy = state.get("wolf_strategy", {}) if isinstance(state, Mapping) else {}
+        request_phase = str(request.get("phase") or "").lower()
+        request_channel = str(request.get("channel") or "").lower()
+        is_night = self._is_night_phase(request_phase) or any(
+            token in request_channel for token in ("night", "wolf", "夜")
+        )
+        preferred: list[str] = []
+        if is_night and isinstance(strategy, Mapping):
+            locked = strategy.get("locked_plan")
+            if isinstance(locked, Mapping):
+                preferred.extend(
+                    str(locked[key]) for key in ("primary_target_id", "backup_target_id")
+                    if locked.get(key) is not None
+                )
+            order = strategy.get("candidate_order")
+            if isinstance(order, list):
+                preferred.extend(
+                    str(item.get("player_id")) for item in order
+                    if isinstance(item, Mapping) and item.get("player_id") is not None
+                )
+        elif isinstance(strategy, Mapping):
+            focus = strategy.get("day_focus")
+            if isinstance(focus, Mapping):
+                obj = focus.get("object")
+                if isinstance(obj, Mapping) and obj.get("player_id") is not None:
+                    preferred.append(str(obj["player_id"]))
+                order = focus.get("candidate_order")
+                if isinstance(order, list):
+                    preferred.extend(
+                        str(item.get("player_id")) for item in order
+                        if isinstance(item, Mapping) and item.get("player_id") is not None
+                    )
+        target = next((item for item in preferred if item in valid), valid[0])
+        repaired = dict(action)
+        repaired["request_id"] = request.get("request_id", action.get("request_id"))
+        repaired["player_id"] = request.get("player_id", action.get("player_id"))
+        repaired["target_id"] = target
+        return repaired
 
