+    def _recent_night_failure_penalty(self, target_id: str) -> int:
+        history = self._game_memory.get("resolved_night_memory") or []
+        if not isinstance(history, list):
+            return 0
+        consecutive = 0
+        for entry in reversed(history):
+            if not isinstance(entry, Mapping) or entry.get("result") != "no_death":
+                break
+            if str(entry.get("primary_target_id")) != str(target_id):
+                break
+            consecutive += 1
+        if consecutive >= 2:
+            return 12
+        return 6 if consecutive == 1 else 0
 
