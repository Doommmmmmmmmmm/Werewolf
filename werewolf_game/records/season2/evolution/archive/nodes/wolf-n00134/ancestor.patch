+    def _verified_public_claims(
+        self,
+        current_dialogue: list[dict[str, Any]],
+        memory_snapshot: Mapping[str, Any],
+    ) -> list[dict[str, Any]]:
+        """只从可见原文抽取保守身份事实，绝不把流言结构化成声明。"""
+
+        game = memory_snapshot.get("game") or {}
+        known_ids = {
+            str(item)
+            for item in (game.get("alive_players") or []) + (game.get("dead_players") or [])
+        }
+        claims: list[dict[str, Any]] = []
+        role_patterns = (
+            ("seer", ("预言家",)),
+            ("guard", ("守卫",)),
+            ("witch", ("女巫",)),
+            ("hunter", ("猎人",)),
+            ("villager", ("平民",)),
+        )
+        for item in current_dialogue[-5:]:
+            if not isinstance(item, Mapping):
+                continue
+            speaker = item.get("speaker") or item.get("player_id") or item.get("from")
+            text = item.get("text") or item.get("content") or item.get("message")
+            if speaker is None or not text:
+                continue
+            source = self._clip_text(str(text), _MAX_SNIPPET_LENGTH)
+            # 当前已知玩家 ID 优先，pN 是回放和行动包中常见的通用形式。
+            mentions = set(known_ids)
+            mentions.update(re.findall(r"(?<![\w])p\d+(?![\w])", source, flags=re.IGNORECASE))
+            target_after = lambda keyword: next(
+                (pid for pid in sorted(mentions, key=len, reverse=True)
+                 if re.search(re.escape(keyword) + r"[^。；，,：:]{0,12}" + re.escape(pid), source, re.IGNORECASE)),
+                None,
+            )
+            if "不是" not in source and any(
+                marker in source for marker in ("我是", "我跳", "跳预言家", "跳守卫", "跳女巫", "跳猎人")
+            ):
+                for claim_type, roles in role_patterns:
+                    if any(role in source for role in roles):
+                        claims.append(
+                            {"speaker": str(speaker), "claim_type": claim_type, "target_id": None, "source_text": source}
+                        )
+                        break
+            for keyword, claim_type in (("查杀", "查杀"), ("金水", "金水")):
+                if keyword in source:
+                    claims.append(
+                        {
+                            "speaker": str(speaker),
+                            "claim_type": claim_type,
+                            "target_id": target_after(keyword),
+                            "source_text": source,
+                        }
+                    )
+            if "对跳" in source and any(role in source for _, roles in role_patterns for role in roles):
+                claims.append(
+                    {"speaker": str(speaker), "claim_type": "对跳", "target_id": None, "source_text": source}
+                )
+        # 同一原文可能同时命中多个保守关键词，保留最近几条即可。
+        return claims[-5:]
