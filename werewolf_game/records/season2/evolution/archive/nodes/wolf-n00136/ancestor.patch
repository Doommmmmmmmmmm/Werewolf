+    def _repair_wolf_vote_action(
+        self,
+        action: dict[str, Any],
+        turn_packet: Mapping[str, Any],
+        memory_snapshot: Mapping[str, Any],
+        current_dialogue: list[dict[str, Any]],
+        wolf_strategy: Mapping[str, Any],
+    ) -> dict[str, Any]:
+        """只对狼刀投票做角色特定的目标修复，不改变其它行动路径。"""
+        request = turn_packet.get("request") or {}
+        if action.get("kind") != "wolf_kill_vote":
+            return action
+        allowed_actions = request.get("allowed_actions")
+        if not isinstance(allowed_actions, list) or not any(
+            isinstance(item, Mapping) and item.get("kind") == "wolf_kill_vote"
+            for item in allowed_actions
+        ):
+            return action
+        plan = self._sanitize_wolf_plan(
+            wolf_strategy, request, memory_snapshot, current_dialogue
+        )
+        locked = plan.get("locked_plan") if isinstance(plan, Mapping) else {}
+        locked = locked if isinstance(locked, Mapping) else {}
+        legal = self._legal_target_ids(request, "wolf_kill_vote")
+        dead = {
+            str(item)
+            for item in ((memory_snapshot.get("game") or {}).get("dead_players") or [])
+        }
+        legal = [item for item in legal if item != self.player_id and item not in dead]
+        if not legal:
+            return action
+        primary = locked.get("primary_target_id")
+        backup = locked.get("backup_target_id")
+        replacement = next((item for item in (primary, backup) if item in legal), None)
+        if replacement is None:
+            replacement = sorted(legal, key=self._stable_target_key)[0]
+        chosen = action.get("target_id")
+        explicit = bool((plan.get("discussion_signal") or {}).get("explicit_consensus"))
+        consensus = (plan.get("discussion_signal") or {}).get("consensus_target")
+        # 合法但分歧的模型输出也统一到锁定主刀；只有最近讨论明确拍板了另一个
+        # 合法目标时，才允许该新共识覆盖旧锁定。
+        canonical = (
+            consensus if explicit and consensus in legal
+            else replacement
+        )
+        if chosen not in legal or chosen != canonical:
+            repaired = dict(action)
+            repaired["target_id"] = canonical
+            self._record_wolf_vote_repair(
+                turn_packet,
+                chosen=chosen,
+                replacement=canonical,
+                reason="非法目标" if chosen not in legal else "未遵循最后一致主刀",
+            )
+            stored = self._game_memory.get("wolf_plan")
+            if isinstance(stored, dict):
+                stored["fallback_occurred"] = chosen not in legal
+            return repaired
+        return action
+
+    def _record_wolf_vote_repair(
+        self,
+        turn_packet: Mapping[str, Any],
+        *,
+        chosen: object,
+        replacement: str,
+        reason: str,
+    ) -> None:
+        self._self_history.append({
+            "round": self._safe_get(turn_packet.get("game"), "round"),
+            "phase": self._safe_get(turn_packet.get("request"), "phase"),
+            "kind": "wolf_vote_repair",
+            "chosen_target_id": None if chosen is None else str(chosen),
+            "replacement_target_id": replacement,
+            "reason": reason,
+        })
+        self._self_history = self._self_history[-_MAX_HISTORY_ITEMS:]
+
+    def _resolve_previous_night_plan(self, summary: Mapping[str, Any]) -> None:
+        plan_state = self._game_memory.get("wolf_plan")
+        if not isinstance(plan_state, dict) or plan_state.get("resolved"):
+            return
+        plan_round = plan_state.get("plan_round")
+        current_round = summary.get("round")
+        phase = str(summary.get("phase") or "").lower()
+        is_day = phase and not any(token in phase for token in ("night", "夜"))
+        if current_round == plan_round and not is_day:
+            return
+        raw_dead = summary.get("dead_players") or []
+        current_dead = {str(item) for item in raw_dead}
+        start_dead = {
+            str(item) for item in plan_state.get("start_dead_players", [])
+        }
+        if current_dead:
+            new_dead_set = current_dead - start_dead
+        else:
+            start_alive = {str(item) for item in plan_state.get("start_alive_players", [])}
+            current_alive = {str(item) for item in (summary.get("alive_players") or [])}
+            new_dead_set = start_alive - current_alive if start_alive and current_alive else set()
+        new_dead = sorted(new_dead_set, key=self._stable_target_key)
+        primary = plan_state.get("primary_target_id")
+        backup = plan_state.get("backup_target_id")
+        if primary in new_dead:
+            result = "success"
+        elif new_dead:
+            result = "other_death"
+        else:
+            result = "no_death"
+        memory = {
+            "round": plan_round,
+            "primary_target_id": primary,
+            "backup_target_id": backup,
+            "legal_target_ids": list(plan_state.get("legal_target_ids") or []),
+            "deaths": new_dead,
+            "result": result,
+            "fallback": bool(plan_state.get("fallback_occurred")),
+        }
+        resolved = self._game_memory.setdefault("resolved_night_memory", [])
+        resolved.append(memory)
+        self._game_memory["resolved_night_memory"] = resolved[-_MAX_HISTORY_ITEMS:]
+        plan_state["resolved"] = True
 
