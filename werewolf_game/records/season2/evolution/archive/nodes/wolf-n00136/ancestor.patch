+            "若其不在 legal_target_ids 才提交 backup_target_id；"
+            "两者都不合法才提交 legal_target_ids[0]。"
+        )
+
+    def _store_wolf_plan(self, plan: Mapping[str, Any], signature: Mapping[str, Any]) -> None:
