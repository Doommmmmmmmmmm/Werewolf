+    sanitized = agent._sanitize_wolf_plan(plan, request, snapshot, [])
+    assert sanitized["locked_plan"]["primary_target_id"] == "p2"
+    assert sanitized["locked_plan"]["primary_target_id"] in {"p2", "p3"}
+
+    packet = {"request": request, "game": {"round": 1}}
+    repaired = agent._repair_wolf_vote_action(
+        {"kind": "wolf_kill_vote", "target_id": "p99"},
