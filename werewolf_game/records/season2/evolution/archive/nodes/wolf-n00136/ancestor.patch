+        snapshot,
+        [],
+        sanitized,
+    )
+    assert repaired["target_id"] == "p2"
+    request["allowed_actions"][0]["target_ids"] = ["p3"]
+    changed = agent._sanitize_wolf_plan(sanitized, request, snapshot, [])
+    assert changed["locked_plan"]["primary_target_id"] == "p3"
+
+    # 同一计划和讨论给两名狼相同 canonical vote，确保不会产生 1-1 分票。
+    packet["request"] = request
+    a = agent._repair_wolf_vote_action(
+        {"kind": "wolf_kill_vote", "target_id": "p2"}, packet, snapshot, [], changed
+    )
+    b = agent._repair_wolf_vote_action(
+        {"kind": "wolf_kill_vote", "target_id": "p1"}, packet, snapshot, [], changed
+    )
+    assert a["target_id"] == b["target_id"] == "p3"
