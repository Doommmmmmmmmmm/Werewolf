+    @staticmethod
+    def _player_id_pattern(player_id: str) -> str:
+        target = str(player_id)
+        if re.fullmatch(r"[A-Za-z0-9_]+", target):
+            return rf"(?<![A-Za-z0-9_]){re.escape(target)}(?![A-Za-z0-9_])"
+        return rf"(?<!\w){re.escape(target)}(?!\w)"
+
+    @classmethod
+    def _player_id_in_text(cls, text: str, player_id: str) -> bool:
+        """按 token 匹配 ID，避免 p1 命中 p10/p11。"""
+        target = str(player_id)
+        return bool(target) and re.search(cls._player_id_pattern(target), str(text)) is not None
+
+    def _legal_target_ids(self, request: Mapping[str, Any], kind: str) -> list[str]:
+        """返回本次行动包中该 kind 的原始合法候选，保持引擎顺序。"""
+        actions = request.get("allowed_actions")
+        if not isinstance(actions, list):
+            return []
+        for action in actions:
+            if not isinstance(action, Mapping) or str(action.get("kind") or "") != str(kind):
+                continue
+            raw = action.get("target_ids")
+            if not isinstance(raw, list):
+                return []
+            result: list[str] = []
+            for target_id in raw:
+                target = str(target_id)
+                if target and target != self.player_id and target not in result:
+                    result.append(target)
+            return result
+        return []
+
+    def _is_legal_target(self, target_id: object, request: Mapping[str, Any], kind: str) -> bool:
+        return str(target_id) in self._legal_target_ids(request, kind)
+
+    @staticmethod
+    def _stable_target_key(target_id: str) -> tuple[int, str]:
+        match = re.search(r"\d+", str(target_id))
+        return (int(match.group()) if match else 10**9, str(target_id))
+
+    def _sanitize_wolf_plan(
+        self,
+        plan: Mapping[str, Any],
+        request: Mapping[str, Any],
+        memory_snapshot: Mapping[str, Any],
+        current_dialogue: list[dict[str, Any]],
+    ) -> dict[str, Any]:
+        """把夜刀计划绑定到当前行动包；计划中的 target_id 不得越过这层。"""
+        result = dict(plan)
+        vote_kind = "wolf_kill_vote"
+        legal = self._legal_target_ids(request, vote_kind)
+        if not legal:
+            actions = request.get("allowed_actions")
+            target_actions = [
+                item for item in actions or []
+                if isinstance(item, Mapping) and item.get("target_ids")
+            ] if isinstance(actions, list) else []
+            legal = self._collect_target_ids(target_actions)
+        dead = {
+            str(item)
+            for item in ((memory_snapshot.get("game") or {}).get("dead_players") or [])
+        }
+        legal = [target for target in legal if target != self.player_id and target not in dead]
+        signal = result.get("discussion_signal")
+        if not isinstance(signal, Mapping):
+            signal = self._parse_wolf_discussion(current_dialogue, legal)
+        legal_set = set(legal)
+        old_locked = result.get("locked_plan")
+        old_locked = dict(old_locked) if isinstance(old_locked, Mapping) else {}
+        ranked = result.get("candidate_order")
+        ranked_ids = [
+            str(item.get("player_id")) for item in ranked or []
+            if isinstance(item, Mapping) and str(item.get("player_id")) in legal_set
+        ]
+        discussion_ids = [
+            str(signal.get(key)) for key in
+            ("consensus_target", "primary_target", "backup_target")
+            if signal.get(key) is not None and str(signal.get(key)) in legal_set
+        ]
+        old_ids = [
+            str(old_locked.get(key)) for key in ("primary_target_id", "backup_target_id")
+            if old_locked.get(key) is not None and str(old_locked.get(key)) in legal_set
+        ]
+        order: list[str] = []
+        # 只有明确的最后一致信号才越过已有 ranking；普通提及仍服从已锁计划。
+        if signal.get("explicit_consensus"):
+            order.extend(discussion_ids[:1])
+        order.extend(old_ids[:1])
+        order.extend(ranked_ids)
+        order.extend(discussion_ids)
+        order.extend(old_ids[1:])
+        order.extend(sorted(legal, key=self._stable_target_key))
+        ordered = list(dict.fromkeys(item for item in order if item in legal_set))
+        primary = ordered[0] if ordered else None
+        backup = next((item for item in ordered[1:] if item != primary), None)
+        locked = dict(old_locked)
+        locked.update({
+            "primary_target_id": primary,
+            "backup_target_id": backup,
+            "legal_target_ids": list(legal),
+            "plan_round": old_locked.get("plan_round", result.get("plan_round")),
+            "plan_signature": old_locked.get("plan_signature", result.get("signature")),
+        })
+        result["locked_plan"] = locked
+        result["primary_target"] = next((item for item in ranked or [] if isinstance(item, Mapping) and item.get("player_id") == primary), {"player_id": primary} if primary else None)
+        result["backup_target"] = next((item for item in ranked or [] if isinstance(item, Mapping) and item.get("player_id") == backup), {"player_id": backup} if backup else None)
+        result["legal_target_ids"] = list(legal)
+        result["plan_round"] = locked.get("plan_round")
+        result["wolf_vote_instruction"] = self._wolf_vote_instruction(locked)
+        return result
+
+    @staticmethod
+    def _wolf_vote_instruction(locked_plan: Mapping[str, Any]) -> str:
+        return (
