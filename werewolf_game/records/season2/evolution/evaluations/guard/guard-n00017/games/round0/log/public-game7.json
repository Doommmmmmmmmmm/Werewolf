      "recipients": [],
      "payload": {
        "player_id": "p6",
        "text": "行，我认。那句“7号倒了”是我故意抛的饵，想看看谁不核对状态就跟着踩我。结果p8、p9、p12接得太顺，反而像提前对过词。至于票型冲我，狼队乐见其成。我走了，留给你们一个提醒：盯紧那三个没犹豫就投票的人，别等下一夜再后悔。",
        "death_index": 4,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
