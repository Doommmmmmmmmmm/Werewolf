    {
      "seq": 254,
      "type": "PLAYER_SPOKE",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p6",
        "stage": "day_discussion",
        "text": "先说票型。p1警长跳预言家查杀，p10也跳预带女巫说法，两边信息撞得厉害。我倾向先压一手：哪位的查杀对象更具体、且和白天发言对得上？空喊身份的往后放。活着的是1、2、6、7、8、9、11、12，八个人四狼面不小，今天别出乱子。我建议按金水链排嫌疑，谁保的人被实锤查杀谁跟票走。我先听p2和p11把链条讲清楚再定票。"
      }
    },
    {
      "seq": 255,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
