    {
      "seq": 289,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p1",
        "text": "我是平民，被票走挺无奈的。回头看，p3和p4的发言一直在带节奏往我身上引，票型也很整齐，狼面不小。活着的几位重点听谁在推卸、谁急着定论。警长p9稳一点，别被冲了。好人加油。",
        "death_index": 5,
