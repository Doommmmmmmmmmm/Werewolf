    {
      "seq": 299,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p9",
        "text": "被归票我不意外，但p4你拿警徽归我，自己验人链一个字没交，这才是真问题。好人别只盯我冲权重——p1、p5跟着喊关注p9，却连昨晚谁倒的都没盘清，票型这么齐，像提前对过词。我死之后请重点压p4的候选名单到底给不给得出来，给不出他才是搅局那个。",
        "death_index": 5,
