    {
      "seq": 275,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p8",
        "text": "p4别拿规则当挡箭牌，R2无主起选我认，但你票权1.5压死全场才是真问题。p3刚才急着撇清不咬警徽来源，反而暴露你们抱团。我虽出局，但狼队刀口必在神职链上，存活队友请继续盯紧p4的动向，别让他控场翻盘。",
        "death_index": 5,
