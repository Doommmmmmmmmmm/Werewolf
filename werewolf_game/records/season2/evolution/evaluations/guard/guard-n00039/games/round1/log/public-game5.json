      "recipients": [],
      "payload": {
        "player_id": "p4",
        "text": "遗言简短：我是闭眼村民，被放逐没有异议可翻。票型上我注意到p3这轮自称无查验可报，与他此前持续报验的说法有转折，值得活着的人追问；p7反手把矛头全压在我身上、却不解释这个转折，我也记一笔。暂不投p9这条我和场上多数人一致。剩下8人里4狼，别再把火力浪费在互咬回应上，先把对跳和警长查验链盘清楚再归票。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
