      "type": "PLAYER_SPOKE",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "stage": "day_discussion",
        "text": "我是警长p4，平民。目前存活四人：我、10、11、12。场上狼队还剩多少？若只剩一狼，我们票型需高度统一。请10-12号先发言，重点说明昨晚行动逻辑及互保关系，我会综合判断后归票。"
      }
