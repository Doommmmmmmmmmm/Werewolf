    {
      "seq": 297,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p10",
        "text": "我确实是守卫，之前对跳预言家是想扰乱狼队刀法。上一夜我守了p9，如果他是真预言家，希望我的守护保住了他的查验链。现在局面已经很不利了，好人别慌，记住昨晚是平安夜或者谁倒牌的信息，狼面大概率在没站边的位置里。剩下的牌交给你们了，票型别乱，把逻辑链最含糊的送走。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
