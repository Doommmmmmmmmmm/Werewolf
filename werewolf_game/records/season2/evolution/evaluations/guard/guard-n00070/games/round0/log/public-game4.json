    {
      "seq": 279,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p7",
        "text": "既然票已经冲我来了，那我走之前留一句：今天出9号是警长归的票，4号嘴上说认可追死人不对、手上却跟着走，这俩人的态度你们自己品。我认我是挡刀的平民，但场上活着的六个人里狼占四席，别把功劳记在1号头上。下一轮重点看1号和4号的票，谁再顺着警权推人，谁就是递刀的那个。",
        "death_index": 6,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
