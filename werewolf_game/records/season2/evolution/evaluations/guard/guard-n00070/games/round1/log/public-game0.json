    {
      "seq": 101,
      "type": "PLAYER_SPOKE",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "stage": "day_discussion",
        "text": "警长p12，既然你当选了，第一轮压力给到你。我作为悍跳预言家，昨晚验p5是金水，但p5首夜就死，这刀法很脏。我强烈怀疑刀口在狼队内部自刀或做身份，请警长组织投票时重点盘查谁在帮狼队控场。我建议先出票型最乱、没有明确站边的人，比如p2和p8，看他们反应。"
      }
    },
    {
      "seq": 102,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p3",
