    {
      "seq": 292,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "text": "6号逼我报验人，可惜我确实没等到今晚。我只提醒一句：p5猎人被毒没开枪，说明女巫大概率已经没了或者暴露，那场上能自证的只剩预言家。今天票别乱走，重点听谁能报出完整验人链。我这条命换不来信息就白给，但1号、8号、11号里谁在回避对跳，谁就是狼。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
