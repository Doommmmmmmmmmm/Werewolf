    {
      "seq": 286,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p9",
        "text": "我p9是猎人，已翻面。带走谁我心里有数，但今天先留句话：p2你拿“查杀链”当挡箭牌，整条链只有你一个人在讲，p4昨天就是按你方向投的，结果好人照样掉。我死前盯着的就是这种独苗归票位。活着的人复盘一下上轮票型，别被1.5票绑架。",
        "death_index": 6,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
