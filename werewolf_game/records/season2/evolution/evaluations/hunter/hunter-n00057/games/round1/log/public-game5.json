    {
      "seq": 286,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p6",
        "text": "既然我被票出去了，那说点实在的。p9、p10、p12今天联手把票推给我，节奏配合得太默契了，像是早就对好口径。我刚才踩p7只是基于他上轮模糊的判断，未必准；但你们三个一口一个“替狼编动机”，却没给任何硬逻辑，这才是真问题。p8你之前站我这边，现在该醒醒了。剩下的好人别再把票送给抱团的人，重点看p9和p12下一轮的发言是否还这么同步。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
