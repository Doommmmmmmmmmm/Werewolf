    {
      "seq": 320,
      "type": "DAY_SPEECH_ORDER_SET",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "round": 4,
        "reference_seat": 1,
        "reference_is_dawn_death": false,
        "direction": "next",
        "speaker_ids": [
          "p2",
