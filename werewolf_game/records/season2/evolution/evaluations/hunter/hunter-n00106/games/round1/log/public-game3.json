    {
      "seq": 281,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p10",
        "text": "我走了，猎人身份公开。p11那条查验链确实对得上p1死亡，可信度比我高；但我死前没报结果是因为我是猎人不是预言家，被你们当查杀打了一轮。剩下好人别内耗：盯p9，他从一开始就带节奏踩我对跳村民，闭眼直觉这种话是狼最爱用的挡箭牌。票型上谁跟p9走谁嫌疑大。",
        "death_index": 6,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
