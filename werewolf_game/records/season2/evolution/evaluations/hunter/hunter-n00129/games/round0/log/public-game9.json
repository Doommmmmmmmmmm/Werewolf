    {
      "seq": 318,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p8",
        "text": "我是8号猎人，被你们白天票出去的。我这一枪没法开——不是不想，是引擎没给我开枪机会，说明我死法不对或者已经处理过了。留几句话：p2从R2就盯着我带节奏投我，今天又第一个冲我，行为很值得怀疑。p1警长身份至今没人对跳，但也没人验过他，别盲信。剩下的好人，重点看谁急着把水搅浑、谁在保护p2。祝好人赢。",
        "death_index": 6,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
    {
