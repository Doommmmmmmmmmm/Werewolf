    {
      "seq": 281,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p8",
        "text": "我走了，留几句给好人：我是闭眼村民，没查杀可报。票型上我提醒两点：一、2警长和3都把我跟7一起点名，但7先交了细节、我后交，节奏像提前排好的剧本，请活人复盘谁在带这个节奏。二、4猎人开枪空响这条链被反复利用来咬人，但它本身不能证明谁狼。我怀疑的不是7，是那个一直躲在票型后面不表态的位置。9到12今天必须站出来选边，别再缩着。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
