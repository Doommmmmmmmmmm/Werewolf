    },
    {
      "seq": 143,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p1",
        "text": "我是守卫，昨晚守了自己，结果还是被票出去了。平安夜是我守的，女巫没用药。4号你验我1号？可惜我已经没了，你这条查验链断在这儿。好人别光看警徽，今天出我这种首置位发言平淡的，狼反而舒服。剩下的人盯紧谁在带节奏把水搅浑，尤其踩我“留后路”的那两位，自己品。",
        "death_index": 1,
        "eligible_death_index": 1,
        "trigger_phase": "day_vote"
      }
