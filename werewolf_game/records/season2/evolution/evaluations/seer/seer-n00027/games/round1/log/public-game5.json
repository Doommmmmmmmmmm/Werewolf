    {
      "seq": 283,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p7",
        "text": "我走了。公开事实：3、5、9、10和我已死，无警长链。我的立场一直很简单：出票要有硬锚点，不能只靠\"发言模糊\"这种定性。8号被6号点，但至今没人给出8哪轮票型跟谁走偏了；反过来11号盯着我甩锅，可我自己也没查到东西可报。剩下的活人里，我希望你们把每一轮的投票记录摆出来对一遍，谁在关键票上反复变向，比谁话说得漂亮更能定狼。别抱团冲一个没实锤的人。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
