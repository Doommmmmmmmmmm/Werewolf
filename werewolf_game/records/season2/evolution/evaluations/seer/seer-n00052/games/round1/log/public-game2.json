      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p10",
        "stage": "day_discussion",
        "text": "我是平民。目前只有p6死亡，信息太少。我关注p7警长，看他后续查验链是否稳定。暂不投p1，因为他是首号位发言且无硬对跳。其他玩家先听逻辑，别乱带节奏。"
      }
