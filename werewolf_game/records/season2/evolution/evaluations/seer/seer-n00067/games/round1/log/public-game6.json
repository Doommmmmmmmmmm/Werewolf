    {
      "seq": 290,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p7",
        "text": "我是平民，闭眼玩家一个，能说的都说了。我死在这一轮，说明狼人觉得我对他们威胁大或者只是随便刀。提醒活着的几位：p8那条警徽链别盲信，昨天对跳和站边太乱，谁急着压票谁心虚。好人别内讧，把发言矛盾最大的先聊透再出票。愿你们赢。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
