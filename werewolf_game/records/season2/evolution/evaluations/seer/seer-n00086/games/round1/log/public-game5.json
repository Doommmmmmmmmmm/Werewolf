      "recipients": [],
      "payload": {
        "player_id": "p1",
        "stage": "day_discussion",
        "text": "第一轮没什么信息，先听听大家怎么说。我自己是普通好人牌，希望今天有人能站出来报个身份或者给点方向，别浪费票。"
      }
    },
    {
      "seq": 105,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p2",
