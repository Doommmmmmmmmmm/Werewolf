    {
      "seq": 288,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "text": "被投出去我不意外，毕竟我昨天确实没报票向。但p9你替我报？我投的p5，因为他是唯一敢直接点我的人。p8说我不交作业，可你全程只复读我的发言，自己也没给新信息。警长p7归票我，我认，但好人别被狼带节奏——今天剩下的刀口一定在p6或p8之间，他们俩昨天都在躲投票对象。",
        "death_index": 4,
