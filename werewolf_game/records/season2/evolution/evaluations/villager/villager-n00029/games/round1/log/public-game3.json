    {
      "seq": 63,
      "type": "PLAYER_SPOKE",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p2",
        "stage": "sheriff_election",
        "text": "我是预言家，首验6号，金水。警徽流先7后3：7在我上首发言位，最需要听清立场；3离我不远，方便验证。如果我今晚倒了，警徽给7或按顺序验。今天主票压警上跳身份但逻辑站不住的，备选看谁保狼踩我金水6。请好人跟我走，别分票。"
      }
    },
    {
      "seq": 64,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
