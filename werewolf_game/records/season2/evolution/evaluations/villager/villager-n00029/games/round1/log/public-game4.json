      "recipients": [],
      "payload": {
        "player_id": "p9",
        "stage": "day_discussion",
        "text": "3号查1金水，但1、2、3、7已死，查验链断裂。关注4号，存活且无明确身份，需自证。暂不投5号，虽无信息但无负面记录。现在人多，先听发言找逻辑漏洞。"
      }
