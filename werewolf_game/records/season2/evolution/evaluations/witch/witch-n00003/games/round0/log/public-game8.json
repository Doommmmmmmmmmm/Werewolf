    {
      "seq": 292,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p9",
        "text": "我走了，平民一张。回头看我票型就知道我没藏东西。p5猎人被投出去这局真亏，他开枪带走了谁大家心里有数就行。剩下活着的别乱抱团，警长p2你多担点责任，把今天发言里躲躲闪闪的那几个先盘清楚。好人加油，别再送人头了。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
