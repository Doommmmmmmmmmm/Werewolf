    {
      "seq": 297,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p10",
        "text": "我是猎人，已经翻面了。这轮我被票出去，说明狼队把我当成最大威胁在冲票。提醒活着的好人：我没能开枪带走人，是因为引擎没给我反应机会，不是我心虚。重点看今天推我的票型——谁带头冲、谁跟风改口，那里面必有狼。警长p1说自己不是预言家，那真预言家还藏着，别乱跳，先把票型复盘清楚再动手。祝好人赢。",
        "death_index": 4,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
    {
