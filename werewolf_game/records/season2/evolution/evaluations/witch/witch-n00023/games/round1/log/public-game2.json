    {
      "seq": 283,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p7",
        "text": "我走了就把话留清楚：我是被查杀压着走的，不是自己跳出来的。p2你警徽流7、4，结果先死3、6，这条链到今天都没兑现过，却拿它当票型依据，这不叫视角叫惯性。剩下的人别只盯着复读“收边”的那几个，p5说我太齐，可他自己从头到尾也没给过一个能验证的信息。今天如果非出不可，先看谁在躲对线，而不是看谁嗓门大。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
