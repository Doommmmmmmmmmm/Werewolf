    {
      "seq": 101,
      "type": "DAY_SPEECH_ORDER_SET",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "round": 1,
        "reference_seat": 1,
        "reference_is_dawn_death": true,
        "direction": "next",
        "speaker_ids": [
          "p2",
          "p3",
          "p4",
          "p5",
          "p6",
          "p7",
          "p8",
          "p9",
