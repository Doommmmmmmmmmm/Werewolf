      "recipients": [],
      "payload": {
        "player_id": "p8",
        "stage": "day_discussion",
        "text": "先听一圈再表态。目前活着6个人，狼队压力应该很大，今天如果推错人我们直接崩盘。我希望大家把上轮投票逻辑和站边讲清楚，别急着抱团冲票。"
      }
    },
    {
      "seq": 322,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
