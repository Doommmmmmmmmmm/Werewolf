    {
      "seq": 251,
      "type": "PLAYER_SPOKE",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p12",
        "stage": "day_discussion",
        "text": "p11上来就自报平民、还划出“不投金水和被查杀验人”的框，这话说得太满。真正的神职不会第一天就把票权边界替所有人定死，他更像在给狼队递刀——把谁保下来、谁该出局都安排好了。我反而要压他：p11，你既然说自己是民，那警长p3的验人链你怎么看？别拿“先听一圈”糊弄。下一步我建议今天重点听p1、p2对p11这套逻辑的反应，谁顺着他的框走，谁就有问题。"
      }
    },
    {
      "seq": 252,
      "type": "PLAYER_PASSED",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p1",
