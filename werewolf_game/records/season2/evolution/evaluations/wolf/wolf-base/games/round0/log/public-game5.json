    {
      "seq": 285,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "text": "我是预言家，验过p6狼、p9狼、p11好人。现在他俩都出局了，场上还剩一头狼在二、三、七、八、十、十二里。我死前最后提醒：p11是我确认的金水，可以带节奏；警长p2发言多但没被验过，别盲信。剩下的人注意票型，谁一直在搅和保人就重点听。好人加油，把最后一匹狼揪出来。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
    },
