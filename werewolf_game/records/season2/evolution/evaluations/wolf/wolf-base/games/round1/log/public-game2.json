    {
      "seq": 293,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p11",
        "text": "被投出去我也认了。但说句实话，p5今天这波带节奏太刻意了——平安夜他不聊刀口、不聊药，第一时间点名让我解释票型，这是典型的狼人给好人扣帽子转移视线。我昨天投票就是跟着场上多数走的，没什么好藏的。剩下的好人别被这种‘先怀疑最中立的人’的套路牵着走，回头看看谁在回避报自己的票。希望警徽流能压住场面。",
        "death_index": 5,
        "eligible_death_index": 3,
        "trigger_phase": "day_vote"
      }
