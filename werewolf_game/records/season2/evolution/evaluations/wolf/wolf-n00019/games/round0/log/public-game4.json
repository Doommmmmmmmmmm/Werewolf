    {
      "seq": 216,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p4",
        "text": "既然我被票出去了，就留句话：我4号是平民。昨天3号追问票型、5号跟着起哄说我急，这套组合拳打得很默契。今天我走了，好人少一票，接下来重点看8、9、10有没有被警长点名后含糊其辞的。别又被带节奏互咬，谁冲得最猛保谁嫌疑最大。剩下的好人擦亮眼睛。",
        "death_index": 3,
