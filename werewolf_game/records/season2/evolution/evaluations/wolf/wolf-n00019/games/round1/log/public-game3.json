    {
      "seq": 279,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p7",
        "text": "我认，这轮冲p2确实急。但我不是替狼逼神职——是p2两轮不报验人，我只能按最坏情况处理。既然他自己承认不是预言家，那警徽就是白捡的。剩下活人里谁真带信息？p4刚才那段话像复盘机器，不像玩家。我把票留给你们判断，别让我白死。",
        "death_index": 5,
