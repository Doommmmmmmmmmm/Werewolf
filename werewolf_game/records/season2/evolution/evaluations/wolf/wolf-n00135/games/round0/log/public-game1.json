    {
      "seq": 244,
      "type": "DAY_SPEECH_ORDER_SET",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "round": 3,
        "reference_seat": 2,
        "reference_is_dawn_death": true,
        "direction": "next",
        "speaker_ids": [
          "p3",
