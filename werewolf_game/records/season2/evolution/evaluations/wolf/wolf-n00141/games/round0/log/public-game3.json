    {
      "seq": 287,
      "type": "PLAYER_LAST_WORDS",
      "visibility": "public",
      "channel": "public",
      "recipients": [],
      "payload": {
        "player_id": "p5",
        "text": "接受p11的纠正，我记错了状态，这轮发言确实乱。但我刀口和票都摆在明面：上轮我投的是p11，不是顺着大流压p12。今天焦点我转给p9——他从头到尾只复读“同意p8”，零独立信息，还顺手把我打成混乱位收人头。剩下的活人里，谁在带节奏清异见，比追一个死人更值得看。",
        "death_index": 4,
